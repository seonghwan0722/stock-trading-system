{
  "info": {
    "_postman_id": "dart-api-collection-2024",
    "name": "Open DART API Collection",
    "description": "Korean Financial Supervisory Service Electronic Disclosure System API\nBase URL: https://opendart.fss.or.kr/api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Company Information",
      "item": [
        {
          "name": "Get Company by Code",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://opendart.fss.or.kr/api/company.json?crtfc_key={{api_key}}&corp_code=00126380",
              "protocol": "https",
              "host": ["opendart", "fss", "or", "kr"],
              "path": ["api", "company.json"],
              "query": [
                {
                  "key": "crtfc_key",
                  "value": "{{api_key}}",
                  "description": "API authentication key"
                },
                {
                  "key": "corp_code",
                  "value": "00126380",
                  "description": "8-digit corporate code (Samsung Electronics)"
                }
              ]
            },
            "description": "Get company information by corporate code\n\nExample: 00126380 = Samsung Electronics (삼성전자)"
          },
          "response": []
        },
        {
          "name": "Search Company by Name",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://opendart.fss.or.kr/api/companysearch.json?crtfc_key={{api_key}}&corp_name=삼성&page_no=1&page_count=10",
              "protocol": "https",
              "host": ["opendart", "fss", "or", "kr"],
              "path": ["api", "companysearch.json"],
              "query": [
                {
                  "key": "crtfc_key",
                  "value": "{{api_key}}"
                },
                {
                  "key": "corp_name",
                  "value": "삼성",
                  "description": "Company name in Korean"
                },
                {
                  "key": "page_no",
                  "value": "1",
                  "description": "Page number (starts at 1)"
                },
                {
                  "key": "page_count",
                  "value": "10",
                  "description": "Results per page (1-100)"
                }
              ]
            },
            "description": "Search companies by name with pagination"
          },
          "response": []
        },
        {
          "name": "Get Company List (Download)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://opendart.fss.or.kr/api/corpCode.json?crtfc_key={{api_key}}",
              "protocol": "https",
              "host": ["opendart", "fss", "or", "kr"],
              "path": ["api", "corpCode.json"],
              "query": [
                {
                  "key": "crtfc_key",
                  "value": "{{api_key}}"
                }
              ]
            },
            "description": "Download complete list of all companies\n\nReturns: Zip file with company list (corp_code and stock_code mapping)"
          },
          "response": []
        }
      ]
    },
