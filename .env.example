# Flask Configuration
ENVIRONMENT=development
SECRET_KEY=  # Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=stock_trading_db

# Admin Account (for initial setup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=  # Set a strong password

# Kiwoom REST API (https://openapi.kiwoom.com)
KIWOOM_APP_KEY=  # Get from Kiwoom OpenAPI portal
KIWOOM_SECRET_KEY=  # Get from Kiwoom OpenAPI portal
KIWOOM_ACCOUNT_NO=  # Your account number

# JWT Configuration (Optional - defaults provided)
JWT_ACCESS_TOKEN_EXPIRES=900  # 15 minutes
JWT_REFRESH_TOKEN_EXPIRES=604800  # 7 days

# Security Settings (Optional - defaults provided)
MAX_LOGIN_ATTEMPTS=5
LOGIN_TIMEOUT=300  # 5 minutes
RATELIMIT_ENABLED=True
RATELIMIT_DEFAULT=100 per hour
CORS_ORIGINS=http://localhost:5000

# Logging (Optional - defaults provided)
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
